# Frontend build outputs — generated by `pnpm build` (which bench triggers via
# the root `package.json` "build" script on `bench build` / `bench update`).
# Hand-written assets in frappe_crm_xt/public/js/ (search_bar.js, style.css)
# stay tracked, so we ignore the two Vite outputs by name rather than the
# whole directory.
frappe_crm_xt/public/js/crm_xt_app.js
frappe_crm_xt/public/js/frappe-crm-xt-frontend.css
